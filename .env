# GrievanceHub Server Configuration
PORT=5000

# MongoDB Connection String:
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/grievancehub

# MongoDB Atlas (Cloud) Example:
# Replace with your Atlas connection URI if using MongoDB Atlas
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grievancehub?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=grievancehub_secure_super_jwt_secret_token_2026_xyz
